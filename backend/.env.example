# Copie este archivo como `.env` y ajuste los valores.
# NUNCA suba el archivo .env real al repositorio.

# Clave secreta de Django (genere una larga y aleatoria en producción)
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
DEBUG=1

# Hosts permitidos separados por coma (en producción ponga su dominio)
ALLOWED_HOSTS=*

# Base de datos (opcional). Si no se define, se usa SQLite local.
# Ejemplo de PostgreSQL en la nube:
# DATABASE_URL=postgresql://usuario:clave@host:5432/delivertrack

# Orígenes del frontend permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=

# Zona horaria del negocio
TIME_ZONE=America/Managua

# Regla de automatización: minutos antes de la hora límite para
# clasificar una entrega como "en riesgo"
RIESGO_MINUTOS=30

# 1 = el tablero evalúa riesgos al consultarse (cómodo para la demo).
# En producción use 0 y programe `manage.py evaluar_riesgos` cada minuto.
EVALUAR_RIESGO_AL_CONSULTAR=1
